<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#8e071a">
  <meta name="description" content="Sai Charan Bangaru — Computer Science Engineer building full-stack web applications and practical AI experiences.">
  <title>Sai Charan Bangaru — Software & AI Portfolio</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #08121f;
      --bg-deep: #050b13;
      --panel: #0e1b2b;
      --panel-2: #122237;
      --line: rgba(211, 229, 246, .12);
      --text: #edf4fb;
      --muted: #a4b4c7;
      --soft: #72859b;
      --blue: #70c7ff;
      --cyan: #68ead5;
      --lime: #c6f36a;
      --accent: #a8dfff;
      --shadow: 0 28px 90px rgba(0,0,0,.26);
      --radius: 24px;
      --max: 1160px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(ellipse at 78% 5%, rgba(42, 112, 163, .20), transparent 31rem),
        radial-gradient(ellipse at 12% 36%, rgba(33, 92, 123, .12), transparent 32rem),
        var(--bg);
      font: 16px/1.65 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      letter-spacing: -.01em;
      overflow-x: hidden;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image: linear-gradient(rgba(176, 211, 238, .025) 1px, transparent 1px), linear-gradient(90deg, rgba(176, 211, 238, .025) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: linear-gradient(to bottom, black, transparent 88%);
    }
    a { color: inherit; text-decoration: none; }
    button, a { -webkit-tap-highlight-color: transparent; }
    button { font: inherit; }
    img { max-width: 100%; display: block; }
    ::selection { background: rgba(104, 234, 213, .28); color: white; }
    :focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
    .wrap { width: min(var(--max), calc(100% - 48px)); margin-inline: auto; }
    .topbar {
      position: fixed; inset: 0 0 auto; z-index: 100;
      height: 76px; display: flex; align-items: center;
      border-bottom: 1px solid transparent;
      transition: background .25s ease, border-color .25s ease, height .25s ease;
    }
    .topbar.scrolled { height: 66px; background: rgba(5, 11, 19, .82); backdrop-filter: blur(18px); border-color: var(--line); }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 26px; }
    .brand { display: inline-flex; align-items: center; gap: 11px; font-weight: 850; letter-spacing: -.055em; font-size: 19px; white-space: nowrap; }
    .brand-mark {
      width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px;
      color: #07121f; font-size: 13px; font-weight: 900; letter-spacing: -.05em;
      background: linear-gradient(135deg, var(--cyan), var(--blue)); box-shadow: 0 5px 22px rgba(104,234,213,.13);
    }
    .nav-links { list-style: none; display: flex; align-items: center; gap: 28px; padding: 0; margin: 0; }
    .nav-links a { color: var(--muted); font-size: 13px; transition: color .2s ease; }
    .nav-links a:hover { color: white; }
    .nav-actions { display: flex; align-items: center; gap: 10px; }
    .button {
      min-height: 44px; display: inline-flex; justify-content: center; align-items: center; gap: 10px;
      padding: 0 17px; border-radius: 12px; border: 1px solid var(--line);
      color: var(--text); background: rgba(255,255,255,.035); font-weight: 700; font-size: 13px;
      cursor: pointer; transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }
    .button:hover { transform: translateY(-2px); border-color: rgba(104,234,213,.45); background: rgba(255,255,255,.07); }
    .button.primary { color: #07121b; border-color: transparent; background: linear-gradient(110deg, var(--cyan), var(--blue)); }
    .button.primary:hover { background: linear-gradient(110deg, #8ff4e3, #91d7ff); }
    .button svg, .text-link svg { width: 15px; height: 15px; flex: 0 0 auto; }
    .menu-toggle { display: none; border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 10px; width: 42px; height: 42px; cursor: pointer; }

    .hero { min-height: 790px; padding: 164px 0 100px; display: flex; align-items: center; position: relative; overflow: hidden; }
    .hero::after { content: ""; position: absolute; right: -9rem; top: 9rem; width: 36rem; height: 36rem; border-radius: 50%; background: radial-gradient(circle, rgba(56, 152, 205, .14), transparent 68%); pointer-events: none; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.14fr) minmax(320px, .86fr); gap: clamp(38px, 7vw, 100px); align-items: center; position: relative; z-index: 1; }
    .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--cyan); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 24px; height: 1px; background: currentColor; }
    h1, h2, h3, p { margin-top: 0; }
    .hero h1 { margin: 24px 0 22px; max-width: 760px; font-size: clamp(3.5rem, 7.6vw, 6.35rem); line-height: .99; letter-spacing: -.085em; font-weight: 850; }
    .hero h1 .outline { color: transparent; -webkit-text-stroke: 1px rgba(237,244,251,.68); }
    .hero h1 .grad { background: linear-gradient(100deg, #e9f6ff 2%, var(--blue) 47%, var(--cyan) 93%); color: transparent; background-clip: text; -webkit-background-clip: text; }
    .hero-summary { max-width: 570px; margin-bottom: 28px; color: var(--muted); font-size: clamp(16px, 1.7vw, 19px); line-height: 1.8; }
    .hero-summary strong { color: var(--text); font-weight: 700; }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
    .hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 22px; margin-top: 32px; color: var(--soft); font-size: 12px; }
    .hero-meta span { display: inline-flex; align-items: center; gap: 8px; }
    .status-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 5px rgba(198,243,106,.08); }
    .hero-card { position: relative; padding: 24px; border-radius: 28px; border: 1px solid rgba(193,222,245,.16); background: linear-gradient(145deg, rgba(21,42,65,.92), rgba(9,22,37,.93)); box-shadow: var(--shadow); overflow: hidden; isolation: isolate; }
    .hero-card::before { content: ""; position: absolute; width: 250px; height: 250px; border: 1px solid rgba(104,234,213,.16); border-radius: 50%; right: -70px; top: -70px; z-index: -1; box-shadow: 0 0 0 22px rgba(104,234,213,.025), 0 0 0 48px rgba(104,234,213,.02); }
    .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--soft); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; }
    .window-dots { display: flex; gap: 5px; }
    .window-dots i { width: 6px; height: 6px; display: block; border-radius: 50%; background: #547187; }
    .profile-art { display: grid; place-items: center; min-height: 275px; position: relative; margin: 18px 0 20px; }
    .orbit { position: absolute; width: 236px; height: 236px; border: 1px solid rgba(112,199,255,.22); border-radius: 50%; transform: rotate(-27deg) scaleY(.65); }
    .orbit::before, .orbit::after { content: ""; position: absolute; border-radius: 50%; width: 8px; height: 8px; background: var(--cyan); box-shadow: 0 0 18px rgba(104,234,213,.8); }
    .orbit::before { top: 27px; left: 23px; }
    .orbit::after { bottom: 19px; right: 38px; width: 5px; height: 5px; background: var(--blue); }
    .monogram { width: 166px; height: 166px; display: grid; place-items: center; border-radius: 50%; font-size: 61px; line-height: 1; letter-spacing: -.1em; font-weight: 900; color: #08121f; background: linear-gradient(135deg, #e8f8ff, #8ddfff 50%, #6fe9d6); box-shadow: 0 20px 65px rgba(74,184,225,.18); border: 7px solid rgba(255,255,255,.08); }
    .floating-chip { position: absolute; border: 1px solid rgba(201,225,244,.15); background: rgba(7,18,31,.88); color: #d8e6f3; border-radius: 12px; padding: 9px 11px; font-size: 11px; font-weight: 700; box-shadow: 0 10px 35px rgba(0,0,0,.2); }
    .floating-chip.one { top: 30px; left: 0; transform: rotate(-4deg); }
    .floating-chip.two { bottom: 30px; right: 0; transform: rotate(4deg); }
    .terminal { border-radius: 16px; background: rgba(3,10,18,.56); border: 1px solid var(--line); padding: 15px 16px; }
    .terminal-line { display: flex; gap: 12px; font: 12px/1.9 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: #91a8bd; }
    .terminal-line .num { color: #4f6d84; user-select: none; }
    .terminal-line .key { color: var(--cyan); }
    .terminal-line .value { color: var(--lime); }
    .hero-card-foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--soft); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; }
    .hero-card-foot strong { color: var(--muted); font-weight: 700; }

    .section { padding: 100px 0; }
    .section-header { display: grid; grid-template-columns: minmax(0, .82fr) minmax(280px, .5fr); align-items: end; gap: 32px; margin-bottom: 42px; }
    .section-header h2 { margin: 15px 0 0; max-width: 700px; font-size: clamp(2.35rem, 4.5vw, 4.2rem); letter-spacing: -.075em; line-height: 1.06; font-weight: 820; }
    .section-header p { margin: 0; color: var(--muted); line-height: 1.8; font-size: 14px; }
    .about-layout { display: grid; grid-template-columns: 1.06fr .94fr; gap: 28px; }
    .summary-card, .quick-facts, .experience-card, .skill-card, .education-card, .cert-card, .contact-panel { border: 1px solid var(--line); background: linear-gradient(145deg, rgba(18,34,53,.88), rgba(12,24,39,.88)); border-radius: var(--radius); }
    .summary-card { padding: clamp(24px, 4vw, 40px); }
    .summary-card .lead { color: #e0eaf4; font-size: clamp(18px, 2.2vw, 24px); line-height: 1.65; letter-spacing: -.035em; }
    .summary-card p:last-child { margin-bottom: 0; }
    .summary-card strong { color: var(--cyan); }
    .quick-facts { padding: 25px; display: grid; gap: 0; }
    .fact { display: grid; grid-template-columns: 96px 1fr; gap: 18px; padding: 17px 0; border-bottom: 1px solid var(--line); }
    .fact:last-child { border-bottom: 0; }
    .fact-num { color: var(--cyan); font-size: 26px; line-height: 1.25; font-weight: 850; letter-spacing: -.07em; }
    .fact-title { color: var(--text); font-weight: 750; font-size: 14px; }
    .fact-desc { color: var(--soft); font-size: 12px; margin-top: 3px; }

    .projects { padding-top: 40px; }
    .projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
    .project-card { position: relative; overflow: hidden; min-height: 400px; padding: clamp(24px, 3vw, 34px); border: 1px solid var(--line); border-radius: 27px; background: linear-gradient(145deg, rgba(18,35,54,.95), rgba(9,20,33,.95)); transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .project-card:hover { transform: translateY(-5px); border-color: rgba(112,199,255,.35); box-shadow: 0 25px 70px rgba(0,0,0,.2); }
    .project-card.featured { grid-column: auto; min-height: 400px; background: radial-gradient(ellipse at 83% 10%, rgba(64,162,200,.18), transparent 24rem), linear-gradient(130deg, rgba(17,42,61,.98), rgba(9,20,33,.97)); }
    .project-card.featured .project-body { display: block; }
    .project-card.featured .project-visual { margin-top: 24px; min-height: 160px; }
    .project-card.featured::after { content: "01"; position: absolute; right: -5px; bottom: -50px; font-size: clamp(140px, 25vw, 280px); line-height: 1; letter-spacing: -.12em; font-weight: 900; color: rgba(218,242,255,.035); pointer-events: none; }
    .project-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 35px; position: relative; z-index: 1; }
    .project-number { color: var(--soft); font: 11px ui-monospace, monospace; letter-spacing: .12em; }
    .project-label { border: 1px solid rgba(104,234,213,.2); background: rgba(104,234,213,.07); color: var(--cyan); border-radius: 999px; padding: 6px 10px; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .project-body { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(230px, .7fr); gap: 46px; align-items: end; }
    .project-card:not(.featured) .project-body { display: block; }
    .project-title { margin: 0 0 14px; font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.08; letter-spacing: -.065em; }
    .project-desc { color: var(--muted); font-size: 14px; line-height: 1.8; max-width: 660px; }
    .project-list { list-style: none; display: grid; gap: 11px; margin: 23px 0 25px; padding: 0; color: #c6d3df; font-size: 13px; }
    .project-list li { position: relative; padding-left: 19px; }
    .project-list li::before { content: "↗"; color: var(--cyan); position: absolute; left: 0; top: 0; font-weight: 800; }
    .tech-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 24px; }
    .tech { padding: 6px 9px; border-radius: 8px; color: #a9c7da; background: rgba(147,188,216,.08); border: 1px solid rgba(147,188,216,.1); font-size: 10px; font-weight: 700; }
    .project-visual { min-height: 190px; display: grid; place-items: center; position: relative; overflow: hidden; border-radius: 20px; background: linear-gradient(145deg, rgba(72,180,206,.12), rgba(112,199,255,.025)); border: 1px solid rgba(168,220,246,.12); }
    .visual-ring { position: absolute; width: 150px; height: 150px; border-radius: 50%; border: 1px solid rgba(104,234,213,.28); box-shadow: 0 0 0 19px rgba(104,234,213,.025), 0 0 0 39px rgba(104,234,213,.02); }
    .visual-glyph { position: relative; z-index: 2; width: 95px; height: 95px; display: grid; place-items: center; border-radius: 28px; color: #071421; background: linear-gradient(135deg, var(--cyan), var(--blue)); box-shadow: 0 18px 50px rgba(104,234,213,.12); transform: rotate(-7deg); }
    .visual-glyph svg { width: 48px; height: 48px; }
    .visual-small { position: absolute; right: 18px; bottom: 16px; color: var(--soft); font: 10px ui-monospace, monospace; }
    .project-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--line); }
    .text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--cyan); font-size: 12px; font-weight: 800; }
    .text-link:hover { color: white; }
    .project-card:not(.featured) .project-visual { margin: 24px 0 0; min-height: 160px; }
    .project-card:not(.featured) .project-title { font-size: clamp(1.65rem, 2.6vw, 2.25rem); }

    .experience-card { padding: clamp(24px, 4vw, 40px); display: grid; grid-template-columns: minmax(180px, .45fr) 1fr; gap: 34px; }
    .experience-date { color: var(--cyan); font: 11px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
    .experience-company { margin: 12px 0 4px; font-size: 22px; font-weight: 850; letter-spacing: -.05em; }
    .experience-role { color: var(--muted); font-size: 13px; }
    .experience-content h3 { font-size: 18px; margin: 0 0 12px; letter-spacing: -.03em; }
    .experience-content p { color: var(--muted); font-size: 13px; line-height: 1.8; }
    .bullet-list { margin: 0; padding-left: 18px; display: grid; gap: 10px; color: #c7d4e0; font-size: 13px; }
    .bullet-list li::marker { color: var(--cyan); }

    .skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .skill-card { padding: 24px; min-height: 185px; }
    .skill-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 12px; background: rgba(104,234,213,.09); color: var(--cyan); border: 1px solid rgba(104,234,213,.15); margin-bottom: 20px; }
    .skill-icon svg { width: 18px; height: 18px; }
    .skill-card h3 { font-size: 15px; margin-bottom: 15px; letter-spacing: -.02em; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 7px; }
    .skill-tags span { padding: 6px 8px; border-radius: 7px; background: rgba(255,255,255,.035); border: 1px solid rgba(255,255,255,.065); color: #b2c2d3; font-size: 11px; }

    .education-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .education-card { position: relative; min-height: 190px; padding: 25px; overflow: hidden; }
    .education-card::after { content: ""; position: absolute; width: 100px; height: 100px; right: -39px; bottom: -43px; border: 1px solid rgba(112,199,255,.14); border-radius: 50%; box-shadow: 0 0 0 15px rgba(112,199,255,.025), 0 0 0 31px rgba(112,199,255,.02); }
    .edu-date { display: inline-block; color: var(--cyan); font: 11px ui-monospace, monospace; margin-bottom: 23px; }
    .education-card h3 { margin-bottom: 8px; font-size: 16px; line-height: 1.4; letter-spacing: -.025em; }
    .education-card p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }

    .cert-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 13px; }
    .cert-card { display: flex; align-items: center; gap: 16px; padding: 20px 22px; transition: border-color .2s ease, transform .2s ease; }
    .cert-card:hover { border-color: rgba(104,234,213,.3); transform: translateY(-2px); }
    .cert-mark { flex: 0 0 43px; width: 43px; height: 43px; border-radius: 14px; display: grid; place-items: center; color: var(--cyan); background: rgba(104,234,213,.09); border: 1px solid rgba(104,234,213,.14); font-size: 12px; font-weight: 900; letter-spacing: -.04em; }
    .cert-name { font-size: 13px; font-weight: 800; line-height: 1.45; }
    .cert-issuer { color: var(--soft); font-size: 11px; margin-top: 4px; }
    .cert-note { color: var(--soft); font-size: 12px; margin: 20px 0 0; }

    .achievement-section { padding-top: 75px; }
    .achievement-wrap { padding: clamp(20px, 4vw, 38px); border-radius: 30px; border: 1px solid rgba(112,199,255,.2); background: radial-gradient(ellipse at 90% 0%, rgba(112,199,255,.16), transparent 27rem), linear-gradient(145deg, #10273d, #091725); box-shadow: var(--shadow); }
    .achievement-grid { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(280px, .94fr); align-items: center; gap: clamp(24px, 4vw, 46px); }
    .achievement-copy h2 { margin: 16px 0 16px; font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.02; letter-spacing: -.075em; }
    .achievement-copy p { color: var(--muted); font-size: 14px; line-height: 1.8; max-width: 480px; }
    .achievement-stats { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; margin: 24px 0 25px; }
    .achievement-stat { border-radius: 14px; padding: 15px; background: rgba(1,9,17,.34); border: 1px solid rgba(205,229,245,.10); }
    .achievement-stat strong { display: block; font-size: clamp(22px, 3vw, 32px); font-weight: 850; line-height: 1.2; letter-spacing: -.07em; color: var(--lime); }
    .achievement-stat span { display: block; margin-top: 5px; color: var(--soft); font-size: 10px; text-transform: uppercase; letter-spacing: .09em; }
    .achievement-image-frame { position: relative; border-radius: 22px; padding: 10px; background: rgba(2,10,18,.48); border: 1px solid rgba(206,229,246,.16); box-shadow: 0 20px 70px rgba(0,0,0,.28); }
    .achievement-image-frame::before { content: "MILESTONE / 2025"; position: absolute; top: -12px; right: 22px; z-index: 2; color: #06131e; background: var(--lime); border-radius: 7px; padding: 6px 10px; font: 800 9px ui-monospace, monospace; letter-spacing: .1em; }
    .achievement-image-frame img { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; border-radius: 14px; background: #fff; }
    .achievement-caption { display: flex; justify-content: space-between; gap: 12px; padding: 12px 5px 2px; color: var(--soft); font-size: 10px; }
    .achievement-caption strong { color: var(--muted); }

    .contact-layout { display: grid; grid-template-columns: 1fr .8fr; gap: 18px; align-items: stretch; }
    .contact-panel { padding: clamp(24px, 4vw, 42px); }
    .contact-panel h2 { margin: 14px 0 18px; font-size: clamp(2.8rem, 5vw, 4.8rem); line-height: .99; letter-spacing: -.08em; }
    .contact-panel p { color: var(--muted); max-width: 450px; font-size: 14px; line-height: 1.8; }
    .contact-links { display: grid; gap: 10px; }
    .contact-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.025); padding: 15px 16px; transition: background .2s ease, border-color .2s ease; }
    .contact-link:hover { background: rgba(255,255,255,.055); border-color: rgba(104,234,213,.3); }
    .contact-label { display: block; color: var(--soft); text-transform: uppercase; font-size: 9px; font-weight: 800; letter-spacing: .12em; margin-bottom: 4px; }
    .contact-value { color: #e0ebf5; font-size: 12px; font-weight: 700; overflow-wrap: anywhere; }
    .contact-arrow { color: var(--cyan); font-size: 18px; }
    .footer { padding: 28px 0 35px; color: var(--soft); font-size: 11px; border-top: 1px solid var(--line); }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap; }
    .footer strong { color: var(--muted); }

    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s cubic-bezier(.2,.75,.25,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: .08s; }
    .delay-2 { transition-delay: .16s; }
    .delay-3 { transition-delay: .24s; }

    @media (max-width: 960px) {
      .nav-links { gap: 17px; }
      .nav-links a { font-size: 12px; }
      .hero { min-height: auto; padding: 140px 0 78px; }
      .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(275px, .78fr); gap: 32px; }
      .hero h1 { font-size: clamp(3.3rem, 7vw, 5rem); }
